[url "https://"]
	insteadOf = git://

[alias]
	graph = log --oneline --decorate=full
	s = status
	a = add
	c = commit -m
	ac = commit -a -m
	st = status
	co = checkout
	ci = commit -v
	di = diff
	br = branch
	puhs = push
	psuh = push
	pus = push
	puh = push
	pl = !git pull && git submodule update --init

[core]
	quotepath = false
	excludesfile = ~/.gitignore
	# delta があれば diff/log を構造化表示する。未導入環境では less にフォールバック。
	pager = delta 2>/dev/null || less

[interactive]
	# add -p 等の対話 diff も delta で色付け。delta が無ければそのまま通す。
	diffFilter = delta --color-only 2>/dev/null || cat

[delta]
	navigate = true      # n/N で差分間を移動
	line-numbers = true  # 行番号列を表示
	light = false        # 暗い背景向けテーマ

[merge]
	conflictstyle = zdiff3

[diff]
	colorMoved = default
	algorithm = histogram

[init]
	defaultBranch = main

[pull]
	rebase = true

[fetch]
	prune = true

[rerere]
	enabled = true

[branch]
	sort = -committerdate

[column]
	ui = auto

[color]
	diff = auto
	status = auto
	branch = auto
	grep = auto

[push]
  default = current
  autoSetupRemote = true

[ghq]
  root = ~/src

[gpg]
	program = gpg
[commit]
	gpgsign = true
[tag]
	gpgsign = true

# マシン固有 / 個人情報 (user.name / email / signingkey 等) は追跡しない
# ~/.gitconfig.local に置き、ここから include して読み込む。
# ファイルが無い場合 git は黙って無視するため、共有時も安全。
# 後方に置くことで ~/.gitconfig.local が上記のどの設定も上書きできる。
[include]
	path = ~/.gitconfig.local
