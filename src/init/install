#!/usr/bin/env bash

# script: install
# brief : easy installer dotfiles and packages
# exec  : bash "$DOT_ROOT"/init/install

set -euo pipefail

typeset -g AUTHOR=fuzziekus
typeset -g LICENSE=MIT
export XDG_DATA_HOME=~/.local/share
export XDG_CONFIG_HOME=~/.config

# REPO
# NOTE: bootstrap 時は SSH 鍵が未設定でも clone できるよう HTTPS を使う
# ブランチ名は 1 箇所 (DOTFILE_BRANCH) で管理し、archive URL と zip 展開先の
# ディレクトリ名 (GitHub は "<repo>-<branch>" で展開する) を両方ここから導出する。
# 別ブランチから入れたい場合は DOTFILE_BRANCH=xxx を環境変数で上書きする。
export DOTFILE_BRANCH="${DOTFILE_BRANCH:-master}"
export DOTFILE_SRC="https://github.com/fuzziekus/dotfiles.git"
export DOTFILE_ARCHIVE="https://github.com/fuzziekus/dotfiles/archive/${DOTFILE_BRANCH}.zip"

export DOT_ROOT=$XDG_CONFIG_HOME/dotfiles


main() {
  local mode="${1:-init}"

  case "$mode" in
    help | -h | --help)
      print_usage
      return 0
      ;;
    init | deploy) ;;
    *)
      log_fail "unknown mode: $mode"
      print_usage
      exit 2
      ;;
  esac

  print_info_this_script
  dotfiles_download
  dotfiles_deploy
  # 引数なし (curl ワンライナー) でも init が走るよう既定を init にする。
  # `deploy` を渡すとリンク作成のみで、パッケージ導入 (make init) はスキップする。
  dotfiles_init "$mode"
}

print_usage() {
  cat <<'USAGE'
Usage: install [mode]

  init      (default) download + deploy symlinks + install packages (make init)
  deploy    download + deploy symlinks のみ (パッケージ導入をスキップ)
  help      このヘルプを表示

Environment:
  DOTFILE_BRANCH=<branch>  取得するブランチ (既定: master)
  ASSUME_YES=1             init 前の確認プロンプトをスキップ (自動化向け)
  DEBUG=1                  実処理せず呼び出しトレースのみ (dry-run)
USAGE
}

print_info_this_script() {
  clear

  local logo='
         __        __   ____ __ __
    ____/ /____   / /_ / __//_// /___   _____
   / __  // __ \ / __// /_ / // // _ \ / ___/
  / /_/ // /_/ // /_ / __// // //  __//__  /
  \__,_/ \____/ \__//_/  /_//_/ \___//____/
 '

  print_format blue "$logo\n" bold
  print_format purple "    $DOTFILE_SRC\n\n"  bold

  print_format blue "   Author:"  bold
  print_format "$AUTHOR"
  print_format blue "     LICENSE:"  bold
  print_format "$LICENSE\n"

  newline
}

dotfiles_download() {

  if is_debug; then
    caller
    return
  fi

  # 既にダウンロード済みなら再取得しない (再実行時に clone が失敗しないように)
  if [ -d "$DOT_ROOT/.git" ]; then
    newline && print_success "Download (already present)"
    return
  fi

  # clone/展開先の親ディレクトリを用意する (新規マシンでは存在しないため)
  mkdir -p "$(dirname "$DOT_ROOT")"

  print_header "Download dotfiles from $DOTFILE_SRC ..."
  if has "git"; then
    git clone --recursive "$DOTFILE_SRC" "$DOT_ROOT"
  elif has "curl" || has "wget"; then
    # NOTE: unzip はパイプ/stdin から zip を読めない (シーク可能なファイルが必要)
    #       ため、一旦一時ファイルへ保存してから展開する。
    local tmpzip
    tmpzip=$(mktemp "${TMPDIR:-/tmp}/dotfiles.XXXXXX.zip")
    if has "curl"; then
      curl -L -o "$tmpzip" "$DOTFILE_ARCHIVE"
    else
      wget -O "$tmpzip" "$DOTFILE_ARCHIVE"
    fi
    unzip -q "$tmpzip"
    rm -f "$tmpzip"
    local extracted="dotfiles-${DOTFILE_BRANCH}"
    if [ ! -d "$extracted" ]; then
      log_fail "$extracted not found"
      exit 1
    fi
    command mv -f "$extracted" "$DOT_ROOT"

  else
    log_fail "curl or wget required"
    exit 1
  fi

  newline && print_success "Download"
}


dotfiles_deploy() {

  exists_dotroot

  if is_debug; then
    caller
    return
  fi

  newline
  print_header "Deploying dotfiles ..."
  cd "$DOT_ROOT"
  if [ -f Makefile ]; then
    make deploy
  else
    log_fail "Makefile: not found"
    exit 1
  fi &&
    newline && print_success "Deploy"
}

dotfiles_init() {
  exists_dotroot

  if is_debug; then
    caller
    return
  fi

  if [ "$1" = "init" ]; then
    # パッケージ導入は sudo 昇格やネットワーク取得を伴うため、対話端末では
    # 実行前に確認する。非対話 (パイプ/CI) や ASSUME_YES=1 のときは自動継続する。
    if [ "${ASSUME_YES:-}" != 1 ] && [ -t 0 ]; then
      newline
      print_header "make init はパッケージ導入や sudo 昇格を行います。"
      printf 'Proceed with init? [y/N] '
      local reply
      read -r reply
      case "$reply" in
        y | Y | yes | YES) ;;
        *)
          log_notice "init をスキップしました (deploy は完了済み)。後で 'make init' を実行できます。"
          return 0
          ;;
      esac
    fi

    newline
    print_header "Initializing dotfiles ..."

    if [ -f Makefile ]; then
      make init
    else
      log_fail "Makefile: not found"
      exit 1
    fi &&
      newline && print_success "Initialize"
  fi
}

# utility functions

is_debug() {
  if [ "${DEBUG:-}" = 1 ]; then
    return 0
  fi
  return 1
}

caller() {
  log_debug "function ${FUNCNAME[1]}"
}

exists_dotroot() {
  if [ ! -d $DOT_ROOT ]; then
    log_fail "$DOT_ROOT: not found"
    exit 1
  fi
}

has() {
  type "$1" >/dev/null 2>&1
  return $?
}

# log.sh
#
# NOTE: 以下のログ/表示ユーティリティは src/init/lib/util.sh と意図的に重複している。
#       この install スクリプトは `curl | bash` のワンライナーでリポジトリ取得前に
#       単独実行されるため、util.sh を source できない (まだ存在しない)。
#       そのため最小限の複製を埋め込む。util.sh 側を変更したらここも同期すること。

newline() {
  printf "\n"
}

print_format() {
  if [ "$#" -eq 0 ] || [ "$#" -gt 3 ]; then
    echo "Usage: print_format <color> <text> <attr>"
    echo "Colors:"
    echo "  black, white, red, green, yellow, blue, purple, cyan "
    return 1
  fi

  local open="\033["
  local close="${open}0m"
  local black="30m"
  local red="31m"
  local green="32m"
  local yellow="33m"
  local blue="34m"
  local purple="35m"
  local cyan="36m"
  local white="37m"
  local gray="90m"
  local default="0;"
  local bold="1;"
  local underline="4;"

  local text="$1"
  local color="$white"
  local attr=${3:-0;}

  if [ "$#" -ge 2 ]; then
    text="$2"
    case "$1" in
      black | red | green | yellow | blue | purple | cyan | gray | white)
      eval color="\$$1"
      ;;
    esac
    if [ "$#" -eq 3 ]; then
      case "$3" in
        default | bold | underline)
          eval attr="\$$3"
          ;;
        *)
          attr="0;"
          ;;
      esac
    fi
  fi

  # NOTE: text はエスケープ (\n 等) を意図的に含むため %b で解釈するが、
  #       書式文字列は固定の '%b' とし text 内の % を書式指定として扱わない。
  printf '%b' "${open}${attr}${color}${text}${close}"
}

log() {
  if [ "$#" -eq 0 ] || [ "$#" -gt 2 ]; then
    echo "Usage: log <fmt> <msg>"
    echo "Formatting Options:"
    echo " TITLE, ERROR, WARN, INFO, SUCCESS"
    return 1
  fi

  local color=
  local text="${2:-}"

  case "$1" in
    DEBUG)
      color=cyan
      ;;
    TITLE)
      color=cyan
      ;;
    ERROR)
      color=red
      ;;
    WARN)
      color=yellow
      ;;
    INFO)
      color=blue
      ;;
    SUCCESS)
      color=green
      ;;
    NOTICE)
      color=purple
      ;;
    *)
      text="$1"
  esac

  timestamp() {
    print_format gray "\["
    print_format purple "$(date +%H:%M:%S)"
    print_format gray "\] "
  }

  timestamp; print_format "$color" "$text"; echo
}

log_pass() {
  log SUCCESS "$1"
}

log_fail() {
  log ERROR "$1" 1>&2
}

log_warn() {
  log WARN "$1"
}

log_info() {
  log INFO "$1"
}

log_echo() {
  log TITLE "$1"
}

log_debug() {
  if is_debug; then
    log_echo "$1"
  fi
}

log_notice() {
  log NOTICE "$1"
}

print_header() {
  print_format white "$*" bold
  newline
}

print_success() {
  print_format " ✔ $* ... "
  print_format green OK
  newline
}

main "$@"
